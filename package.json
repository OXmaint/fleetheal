{
  "name": "fleetheal",
  "version": "0.2.0",
  "private": true,
  "description": "FleetHeal — TrueForge hackathon demo with live DVIR intake, durable store, and mock MCP (no proprietary product code)",
  "type": "module",
  "bin": {
    "fleetheal-mcp": "./mcp/fleet-demo-mock/server.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mcp": "node mcp/fleet-demo-mock/server.js",
    "mcp:approve": "node mcp/fleet-demo-mock/server.js --approve",
    "test": "node --test scripts/test-fleet.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "mcp/",
    "demo/",
    "lib/fleet-core.js",
    "agents/",
    "skills/",
    "eval/",
    "README.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "@upstash/redis": "^1.35.4",
    "@vercel/blob": "^2.0.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
