# --- Web / Vercel persistence (optional) ---
# Prefer one durable backend. If none are set:
#   local `npm run dev` → .data/fleet-state.json
#   Vercel serverless  → in-memory + seed (multi-instance warning)

# Vercel Blob JSON store (recommended on Vercel)
# Create a Blob store in the Vercel dashboard and pull env, or paste the token.
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (alternative to Blob)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- MCP (TrueFoundry Hosted Stdio / local) ---
# When set, fleet-demo-mock reads/writes this app's /api/fleet/* instead of
# only the local demo/seed.json file. Omit for offline `npm start` demos.
# Example after deploy: https://fleetheal.vercel.app
FLEETHEAL_API_BASE=

# Auto-approve gated write tools (local MCP smoke tests only)
# APPROVED=1
