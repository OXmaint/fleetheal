# Vercel Blob (preferred durable store for production / vercel --prod)
BLOB_READ_WRITE_TOKEN=

# Optional write key for MCP persist
FLEETHEAL_API_KEY=

# TrueFoundry Hosted Stdio env for fleet-demo-mock (no trailing slash)
# Example: https://fleetheal.vercel.app
FLEETHEAL_API_BASE=

# Local fallback path if Blob token is unset (dev only)
# FLEET_STATE_PATH=/tmp/fleetheal-state.json
